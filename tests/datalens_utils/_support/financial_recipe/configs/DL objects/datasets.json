      "Гросс-маржа, %: Контроль": {
        "formula": "SUM(IF([conversion_mode] = 'cumulative', [Маржа Контроль исходная накопительно], [Маржа Контроль исходная])) / IF(SUM(IF([conversion_mode] = 'cumulative', [РТО без НДС Контроль исходное накопительно], [РТО без НДС Контроль исходное])) = 0, NULL, SUM(IF([conversion_mode] = 'cumulative', [РТО без НДС Контроль исходное накопительно], [РТО без НДС Контроль исходное])))",
        "cast": "float",
        "kind": "MEASURE",
        "aggregation": "none"
      },
      "РТО с НДС: Дифф": {
        "formula": "IF([dynamics_period] = 'day', NULL, IF([conversion_mode] = 'cumulative', RSUM(SUM(IF(ISNULL([p-value периода исходное]), NULL, IF([p-value периода исходное] <= [alpha], ([РТО Тест исходное] / IF([Участники Тест] = 0, NULL, [Участники Тест]) - [РТО Контроль исходное] / IF([Участники Контроль] = 0, NULL, [Участники Контроль])) * [Участники Тест], 0))) TOTAL ORDER BY [Дата] BEFORE FILTER BY [Дата]), SUM(IF(ISNULL([p-value периода исходное]), NULL, IF([p-value периода исходное] <= [alpha], ([РТО Тест исходное] / IF([Участники Тест] = 0, NULL, [Участники Тест]) - [РТО Контроль исходное] / IF([Участники Контроль] = 0, NULL, [Участники Контроль])) * [Участники Тест], 0)))))",
