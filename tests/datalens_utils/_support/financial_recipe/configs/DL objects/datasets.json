        "formula": "IF([dynamics_period] = 'day', NULL, IF([conversion_mode] = 'cumulative', RSUM(SUM(IF(ISNULL([p-value периода исходное]), NULL, IF([p-value периода исходное] <= [alpha], ([РТО без НДС Тест исходное] / IF([Участники Тест] = 0, NULL, [Участники Тест]) - [РТО без НДС Контроль исходное] / IF([Участники Контроль] = 0, NULL, [Участники Контроль])) * [Участники Тест], 0))) TOTAL ORDER BY [Дата] BEFORE FILTER BY [Дата]), SUM(IF(ISNULL([p-value периода исходное]), NULL, IF([p-value периода исходное] <= [alpha], ([РТО без НДС Тест исходное] / IF([Участники Тест] = 0, NULL, [Участники Тест]) - [РТО без НДС Контроль исходное] / IF([Участники Контроль] = 0, NULL, [Участники Контроль])) * [Участники Тест], 0)))))",
