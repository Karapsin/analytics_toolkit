      "Гросс-маржа, %: Дифф": {
        "formula": "IF([dynamics_period] = 'day', NULL, IF([conversion_mode] = 'cumulative', RSUM(SUM(IF(ISNULL([p-value периода исходное]), NULL, IF([p-value периода исходное] <= [alpha], ([Маржа Тест исходная] / IF([Участники Тест] = 0, NULL, [Участники Тест]) - [Маржа Контроль исходная] / IF([Участники Контроль] = 0, NULL, [Участники Контроль])) * [Участники Тест], 0))) TOTAL ORDER BY [Дата] BEFORE FILTER BY [Дата]), SUM(IF(ISNULL([p-value периода исходное]), NULL, IF([p-value периода исходное] <= [alpha], ([Маржа Тест исходная] / IF([Участники Тест] = 0, NULL, [Участники Тест]) - [Маржа Контроль исходная] / IF([Участники Контроль] = 0, NULL, [Участники Контроль])) * [Участники Тест], 0)))))",
        "cast": "float",
        "kind": "MEASURE",
        "aggregation": "none"
      }
    },
    "parameters": {
      "dynamics_period": {
        "type": "string",
        "default": "day"
      },
      "conversion_mode": {
        "type": "string",
        "default": "period"
