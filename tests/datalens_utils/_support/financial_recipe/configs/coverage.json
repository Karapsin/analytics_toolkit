  "formulas": [
    {
      "category": "published_statistic",
      "owner": "dataset:month",
      "field": "Uplift ARPU CUPED, %",
      "formula": "MAX([Uplift ARPU CUPED, % (исходное)])"
    },
    {
      "category": "period_parameter",
      "owner": "dataset:month",
      "field": "Выбранный период",
      "formula": "[Тип периода] = [report_period]"
    },
    {
      "category": "significant_revenue",
      "owner": "dataset:month",
      "field": "Доп. РТО, руб.",
      "formula": "IF([p-value CUPED числом] < [alpha], [Доп. РТО CUPED, руб.], 0)"
    },
    {
      "category": "summary_significant_revenue",
      "owner": "dataset:month",
      "field": "Сводка: Доп. РТО, руб.",
      "formula": "SUM(IF([p-value CUPED числом (исходное)] < [alpha], [Доп. РТО CUPED, руб. (исходное)], 0))"
    }
  ]
