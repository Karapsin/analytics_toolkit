  "formulas": [
    {
      "category": "simple_aggregation",
      "owner": "dataset:retail",
      "field": "Revenue",
      "formula": "SUM([Revenue Raw])",
      "reference": "https://yandex.cloud/en/docs/datalens/function-ref/SUM"
    },
    {
      "category": "compound_aggregate_arithmetic",
      "owner": "dataset:retail",
      "field": "Net Contribution",
      "formula": "SUM([Profit Raw]) - 0.02 * SUM([Revenue Raw])",
      "reference": "https://yandex.cloud/en/docs/datalens/concepts/calculations/formula-syntax"
    },
    {
      "category": "conditional_aggregation",
      "owner": "dataset:retail",
      "field": "Priority Revenue",
      "formula": "SUM_IF(IFNULL([Revenue Raw], 0), [Priority])",
      "reference": "https://yandex.cloud/en/docs/datalens/function-ref/SUM_IF"
    },
    {
      "category": "null_safe_ratio",
      "owner": "dataset:retail",
      "field": "Margin",
      "formula": "FDIV_SAFE(SUM(IFNULL([Profit Raw], 0)), SUM(IFNULL([Revenue Raw], 0)), 0)",
      "reference": "https://yandex.cloud/en/docs/datalens/function-ref/FDIV_SAFE"
    },
    {
      "category": "date",
      "owner": "dataset:retail",
      "field": "Month",
      "formula": "DATETRUNC([Date], \"month\")",
      "reference": "https://yandex.cloud/en/docs/datalens/function-ref/DATETRUNC"
    },
    {
      "category": "string",
      "owner": "dataset:retail",
      "field": "Category Label",
      "formula": "CONCAT(UPPER([Category]), \" · \", [Channel])",
      "reference": "https://yandex.cloud/en/docs/datalens/function-ref/CONCAT"
    },
    {
      "category": "geopoint",
      "owner": "dataset:delivery",
      "field": "Coordinates",
      "formula": "GEOPOINT([Latitude], [Longitude])",
      "reference": "https://yandex.cloud/en/docs/datalens/function-ref/GEOPOINT"
    },
    {
      "category": "geopolygon",
      "owner": "dataset:delivery",
      "field": "Zone",
      "formula": "GEOPOLYGON([Polygon])",
      "reference": "https://yandex.cloud/en/docs/datalens/function-ref/GEOPOLYGON"
    },
    {
      "category": "level_of_detail",
      "owner": "dataset:retail",
      "field": "Region Revenue Share",
      "formula": "FDIV_SAFE(SUM([Revenue Raw]), SUM([Revenue Raw] FIXED [Region]), 0)",
      "reference": "https://yandex.cloud/en/docs/datalens/concepts/lod-aggregation"
    },
    {
      "category": "moving_window",
      "owner": "chart:wizard_line",
      "field": "Moving Average Revenue",
      "formula": "MAVG(SUM([Revenue Raw]), 6 TOTAL ORDER BY [Date])",
      "reference": "https://yandex.cloud/en/docs/datalens/function-ref/MAVG"
    },
    {
      "category": "running_window",
      "owner": "chart:wizard_line",
      "field": "Cumulative Revenue",
      "formula": "RSUM(SUM([Revenue Raw]) ORDER BY [Date])",
      "reference": "https://yandex.cloud/en/docs/datalens/function-ref/RSUM"
    },
    {
      "category": "ranking_window",
      "owner": "chart:wizard_flat_table",
      "field": "Revenue Rank",
      "formula": "RANK_DENSE(SUM([Revenue Raw]), \"desc\" WITHIN [Region])",
      "reference": "https://yandex.cloud/en/docs/datalens/function-ref/RANK_DENSE"
    },
    {
      "category": "compound_three_aggregates",
      "owner": "dataset:retail",
      "field": "Compound Score",
      "formula": "SUM([Revenue Raw]) + SUM([Profit Raw]) * (SUM([Orders Raw]))",
      "reference": "https://yandex.cloud/en/docs/datalens/concepts/calculations/formula-syntax",
      "educational_only": true
    }
  ],
