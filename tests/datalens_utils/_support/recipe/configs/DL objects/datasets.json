    "calculations": {
      "Orders": {
        "formula": "SUM([Orders Raw])",
        "cast": "integer",
        "kind": "MEASURE",
        "aggregation": "none"
      },
      "Revenue": {
        "formula": "SUM([Revenue Raw])",
        "cast": "float",
        "kind": "MEASURE",
        "aggregation": "none"
      },
      "Profit": {
        "formula": "SUM([Profit Raw])",
        "cast": "float",
        "kind": "MEASURE",
        "aggregation": "none"
      },
      "Target Low": {
        "formula": "SUM([Target Low Raw])",
        "cast": "float",
        "kind": "MEASURE",
        "aggregation": "none"
      },
      "Target High": {
        "formula": "SUM([Target High Raw])",
        "cast": "float",
        "kind": "MEASURE",
        "aggregation": "none"
      },
      "Month": {
        "formula": "DATETRUNC([Date], \"month\")",
        "cast": "date",
        "kind": "DIMENSION",
        "aggregation": "none"
      },
      "Margin": {
        "formula": "FDIV_SAFE(SUM(IFNULL([Profit Raw], 0)), SUM(IFNULL([Revenue Raw], 0)), 0)",
        "cast": "float",
        "kind": "MEASURE",
        "aggregation": "none"
      },
      "Average Order Value": {
        "formula": "FDIV_SAFE(SUM([Revenue Raw]), SUM([Orders Raw]), 0)",
        "cast": "float",
        "kind": "MEASURE",
        "aggregation": "none"
      },
      "Priority Revenue": {
        "formula": "SUM_IF(IFNULL([Revenue Raw], 0), [Priority])",
        "cast": "float",
        "kind": "MEASURE",
        "aggregation": "none"
      },
      "Net Contribution": {
        "formula": "SUM([Profit Raw]) - 0.02 * SUM([Revenue Raw])",
        "cast": "float",
        "kind": "MEASURE",
        "aggregation": "none"
      },
      "Region Revenue Share": {
        "formula": "FDIV_SAFE(SUM([Revenue Raw]), SUM([Revenue Raw] FIXED [Region]), 0)",
        "cast": "float",
        "kind": "MEASURE",
        "aggregation": "none"
      },
      "Category Label": {
        "formula": "CONCAT(UPPER([Category]), \" · \", [Channel])",
        "cast": "string",
        "kind": "DIMENSION",
        "aggregation": "none"
      },
      "Compound Score": {
        "formula": "SUM([Revenue Raw]) + SUM([Profit Raw]) * (SUM([Orders Raw]))",
        "cast": "float",
        "kind": "MEASURE",
        "aggregation": "none"
      }
    },
