ametrize(\n    (\"fault\", \"stage\"),\n    [\n        (\"black\", \"glyphs\"),\n        (\"size\", \"geometry\"),\n        (\"render\", \"render\"),\n        (\"fonts\", \"fonts\"),\n        (\"network\", \"network\"),\n        (\"import\", \"imports\"),\n        (\"success\", \"complete\"),\n    ],\n)\ndef test_actual_capture_program_retains_original_failure_and_produced_png(\n    tmp_path: Path,\n    monkeypatch: Any,\n    fault: str,\n    stage: str,\n) -> None:\n    output, fonts, dimensions, png, calls = fixtures.configure_capture(tmp_path, monkeypatch, fault)\n    if fault == \"success\":\n        exec(compile(probe.CAPTURE, \"contained-capture-program\", \"exec\"), {})\n    else:\n        with pytest.raises((AssertionError, ValueError, ImportError)) as raised:\n            exec(compile(probe.CAPTURE, \"contained-capture-program\", \"exec\"), {})\n    report = json.loads((output / \"capture.json\").read_text())\n    assert report[\"stage\"] == stage\n    assert report[\"ok\"] is (fault == \"success\")\n    assert report[\"visual_approval\"] is False\n    if fault != \"success\":\n        assert report[\"error\"][\"type\"] == type(raised.value).__name__\n        assert report[\"error\"][\"message\"] == str(raised.value)\n        assert \"contained-capture-program\" in report[\"error\"][\"traceback\"]\n    if fault in {\"black\", \"size\", \"success\"}:\n        assert (output / \"infrastructure-only.png\").read_bytes() == png\n        assert report[\"png_sha256\"] == hashlib.sha256(png).hexdigest()\n        assert report[\"image_size\"] == list(dimensions)\n        assert report[\"rgb_extrema\"] == ([[0, 0]] * 3 if fault == \"black\" else [[255, 255]] * 3)\n    if calls:\n        assert set(calls[0]) == {\"svg_string\", \"monospace_family\", \"font_files\"}\n        assert calls[0][\"monospace_family\"] == \"DejaVu Sans Mono\"\n        assert calls[0][\"font_files\"] == [str(fonts / \"fixture.ttf\")]\n        assert (output / \"infrastructure-only.svg\").read_text() == calls[0][\"svg_string\"]\n        assert report[\"render_options\"] == {\n            \"svg_string\": \"infrastructure-only.svg\",\n            \"monospace_family\": \"DejaVu Sans Mono\",\n            \"font_files\": [str(fonts / \"fixture.ttf\")],\n        }\n        policy = fixtures.REPO_ROOT / \"agent_tools/sql_explorer_visual_render.py\"\n        assert report[\"render_policy_sha256\"] == hashlib.sha256(policy.read_bytes()).hexdigest()\n        assert (\n            report[\"font_files\"][str(fonts / \"fixture.ttf\")]\n            == hashlib.sha256(b\"unparseable inspection fixture\").hexdigest()\n        )\n        assert report[\"font_metadata\"][str(fonts / \"fixture.ttf\")][\"inspection_error\"]\n\n\n@pytest.mark.parametrize(\n    \"fault\",\n    [\n        \"install\",\n        \"capture\",\n        \"capture-counter\",\n        \"cleanup\",\n        \"remaining\",\n        \"uncertain\",\n        \"writer\",\n        \"missing\",\n        \"counter\",\n        \"success\",\n    ],\n)\ndef test_native_main_collects_failed_evidence_only_after_certain_cleanup(\n    tmp_path: Path,\n    monkeypatch: Any,\n    fault: str,\n) -> None:\n    state, command_file = fixtures.configure_main(tmp_path, monkeypatch, fault)\n    if fault == \"success\":\n        probe.main()\n    else:\n        with pytest.raises(SystemExit, match=\"Native infrastructure probe failed\"):\n            probe.main()\n    output = next(tmp_path.glob(\"atk-native-probe-*\"))\n    report = json.loads((output / \"isolation-diagnostics/native-probe.json\").read_text())\n    assert report[\"ok\"] is (fault == \"success\")\n    assert report[\"visual_approval\"] is False\n    assert state.counter_reads >= 2\n    if fault in {\"cleanup\", \"remaining\", \"uncertain\", \"writer\"}:\n        assert \"collection_refused\" in report\n        assert not (output / \"probe-evidence\").exists()\n    elif fault == \"missing\":\n        assert report[\"collection_error\"]\n    else:\n        assert report[\"evidence_collected\"]\n        assert (output / \"probe-evidence/probe.json\").is_file()\n        if fault != \"install\":\n            assert (output / \"probe-evidence/capture.json\").is_file()\n    if fault == \"counter\":\n        assert \"counter response unavailable\" in report[\"firewall_counter_error\"]\n        assert \"counter response unavailable\" in report[\"error\"]\n    if fault == \"capture-counter\":\n        assert \"counter response unavailable\" in report[\"firewall_counter_error\"]\n        assert report[\"error\"] == \"ValueError: Native contained capture failed\"\n    if fault == \"writer\":\n        assert command_file.read_bytes() == b\"\"\n    else:\n        assert \"artifact_root=\" in command_file.read_text()\n~~~~\n\n[5] FULL 45 shared-render regression: tests/agent_tools/visual_render.py @467768b9bed2c90a0dfba85ef2eea6ac6868f8d6 | whole bytes=1725 sha256=46a1589de8685ba3dfc77e3fdec15bb7153372da2d4d42868b27adf62f6ce560\n~~~~\n\"\"\"Use the installed Linux font while preserving other render environments.\"\"\"\n\nfrom __future__ import annotations\n\nimport sys\nfrom types import SimpleNamespace\nfrom typing import TYPE_CHECKING, Any\n\nimport pytest\n\nfrom agent_tools import sql_explorer_visual_capture as capture\nfrom agent_tools import sql_explorer_visual_render as policy\n\nif TYPE_CHECKING:\n    from pathlib import Path\n\n\n@pytest.mark.parametrize(\n    (\"platform\", \"present\", \"configured\"),\n    [\n        (\"linux\", True, True),\n        (\"linux\", False, False),\n        (\"darwin\", True, False),\n        (\"win32\", True, False),\n    ],\n)\ndef test_exporter_uses_shared_available_font_policy(\n    tmp_path: Path,\n    monkeypatch: Any,\n    platform: str,\n    present: bool,\n    configured: bool,\n) -> None:\n    font = tmp_path / \"DejaVuSansMono.ttf\"\n    if present:\n        font.write_bytes(b\"font boundary fixture\")\n    monkeypatch.setattr(policy, \"Path\", lambda _name: font)\n    monkeypatch.setattr(policy.sys, \"platform\", platform)\n    calls: list[dict[str, Any]] = []\n\n    def render(**options: Any) -> bytes:\n        calls.append(options)\n        return b\"renderer boundary PNG\"\n\n    monkeypatch.setitem(sys.modules, \"resvg_py\", SimpleNamespace(svg_to_bytes=render))\n    destination = tmp_path / \"nested/frame.png\"\n    capture._write_png('<svg xmlns=\"http://www.w3.org/2000/svg\"/>', destination)\n    assert destination.read_bytes() == b\"renderer boundary PNG\"\n    assert 'width=\"1280\"' in calls[0][\"svg_string\"]\n    assert 'height=\"800\"' in calls[0][\"svg_string\"]\n    if configured:\n        assert calls[0][\"monospace_family\"] == \"DejaVu Sans Mono\"\n        assert calls[0][\"font_files\"] == [str(font)]\n    else:\n        assert set(calls[0]) == {\"svg_string\"}\n~~~~\n\n[6] FULL Complete historical f20b source review: exact467 full source/task review | whole bytes=21937 sha256=f20b3d92a7114a56006f829cc1c6083c0f10d6d29e8354d35962015b335665a7\n~~~~\n{\n  \"schema_version\": 1,\n  \"kind\": \"fresh independent exact PR45 metadata-successor full source and task review\",\n  \"reviewer\": \"/root/review_combined_native_ui_source\",\n  \"created_at_utc\": \"2026-10-18T19:01:23.956581+00:00\",\n  \"decision\": \"approve_exact_head_source_and_one_bounded_current_head_native_dispatch_scope\",\n  \"completeness\": \"complete\",\n  \"findings\": [],\n  \"binding\": {\n    \"repository\": \"Karapsin/analytics_toolkit\",\n    \"pr\": 45,\n    \"url\": \"https://github.com/Karapsin/analytics_toolkit/pull/45\",\n    \"actual_head\": \"467768b9bed2c90a0dfba85ef2eea6ac6868f8d6\",\n    \"single_parent\": \"4143b7eb9cbe7362960a75dd4c6c8a892a28c751\",\n    \"tree\": \"2c759de8b47c045f7ec3c5df327a17526cb12a64\",\n    \"base\": \"f66a80ebe4b3c28dbca17fbc58c2d6ffe464bb01\",\n    \"ref\": \"codex/19ac2eeff8284a2f-17d3108f\",\n    \"task_digest\": \"9e234588b44a3310e115541df26b8c2765e20dc40c4a8224cb471d4f3756ed14\",\n    \"legacy_digest\": \"575f95b6b